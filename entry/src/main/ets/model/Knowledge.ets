/**
 * 检索候选条目。id 形如 "D12"（data 第 12 条）或 "F37"（faq 第 37 条），
 * 用于让端侧模型只回 id、由代码反查原文，保证答案逐字来自知识库。
 */
export class KnowledgeHit {
  id: string;
  question: string;
  answer: string;
  score: number;

  constructor(id: string, question: string, answer: string, score: number) {
    this.id = id;
    this.question = question;
    this.answer = answer;
    this.score = score;
  }
}

/** 导出给教师端的知识条目。id 与 rankCandidates 用同一套编号 */
export interface KnowledgeEntry {
  id: string;
  question: string;
  answer: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

/**
 * 一条候选的【预计算量】。
 *
 * ⚠️ 用 class 而不是 interface —— 之前卡片那次编译失败
 *    （`arkts-no-untyped-obj-literals`）就是对象字面量没有显式声明的类型。
 *    用「类 + 构造函数」彻底绕开字面量规则，不留编译未知数。
 *
 * 这些量原先在【每次 rankCandidates 里都被重算一遍】，而候选从启动起就没变过。
 */
class PreparedEntry {
  id: string;
  /** 原文（整条直接交给 KnowledgeHit，不再改写） */
  key: string;
  answer: string;
  /** canonicalize(question) —— useCanonical=true 时用 */
  tCanon: string;
  /** stripStopWords(question) —— useCanonical=false 时用（A 组三层对比测试那条路） */
  tStrip: string;
  /** normalize(question) */
  tRaw: string;
  /** normalize(answer) */
  aRaw: string;

  constructor(id: string, key: string, answer: string, tCanon: string,
              tStrip: string, tRaw: string, aRaw: string) {
    this.id = id;
    this.key = key;
    this.answer = answer;
    this.tCanon = tCanon;
    this.tStrip = tStrip;
    this.tRaw = tRaw;
    this.aRaw = aRaw;
  }
}

