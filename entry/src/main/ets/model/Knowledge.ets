  ];

  /**
   * 全部候选的预计算量。启动时构建一次，之后每次检索直接复用。
   *
   * 为什么值得缓存（实测）：`canonicalize()` 约 **14.6µs** —— 是 `normalize()`(0.7µs)
   * 的 20 倍、`diceSimilarity()`(1.5µs) 的 10 倍（40 组同义词 split/join +
   * 35 个停用词的 while 循环）。而它原先**在每次 rankCandidates 里都被重算 194 遍** ——
   * 候选从启动起就没变过，这些计算 100% 是重复的。
   *
   * ⚠️ 缓存有效的前提（已逐条验证）：
   *    - `normalize` / `stripStopWords` / `canonicalize` 三者都是**纯函数** ✓
   *    - 它们依赖的 `STOP_WORDS` / `SYNONYM_GROUPS` 是模块级 const，**从未被写入** ✓
   *    - 本缓存的**数据源** `data` / `faq` 也**只有读取、零写入** ✓
   *    所以缓存在实例存活期内不会失效。
   */
  private prepared: PreparedEntry[] = [];

  constructor() {
    this.buildPrepared();
  }

  /** 构建预计算表。顺序与旧版一致：先 data 的键（D0..），再 faq（F0..） */
  private buildPrepared(): void {
    const list: PreparedEntry[] = [];
    const keys: string[] = Object.keys(this.data);
    for (let i = 0; i < keys.length; i++) {
      const k: string = keys[i];
      list.push(this.prepare('D' + i, k, this.data[k]));
    }
    for (let i = 0; i < this.faq.length; i++) {
      const item: FaqItem = this.faq[i];
      list.push(this.prepare('F' + i, item.question, item.answer));
    }
    this.prepared = list;
  }

  /** 单条候选的预计算 */
  private prepare(id: string, question: string, answer: string): PreparedEntry {
    return new PreparedEntry(id, question, answer,
      this.canonicalize(question), this.stripStopWords(question),
      this.normalize(question), this.normalize(answer));
  }

  search(query: string): string {
    const q = query.toLowerCase().trim();
    if (q === '') return '';

    const keys: string[] = Object.keys(this.data);

    // 1. 精确包含匹配
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      if (q.indexOf(key.toLowerCase()) !== -1) {
        return this.data[key];
      }
    }

    // 2. 反向匹配
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      if (key.toLowerCase().indexOf(q) !== -1) {
        return this.data[key];
      }
    }

    // 3. 分词匹配
    const words: string[] = q.split(/[\s，。？?,，、]+/);
    for (let w = 0; w < words.length; w++) {
      const word = words[w];
      if (word.length < 2) continue;
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i];
        if (key.indexOf(word) !== -1 || word.indexOf(key) !== -1) {
          return this.data[key];
        }
      }
    }

    // 4. FAQ 匹配
    for (let i = 0; i < this.faq.length; i++) {
      const faqItem = this.faq[i];
      const questionLower = faqItem.question.toLowerCase();
      if (questionLower.indexOf(q) !== -1 || q.indexOf(questionLower) !== -1) {
        return faqItem.answer;
      }
    }

    return '';
  }

  // ==================== 候选集检索（纯本地，无模型） ====================

  /** 归一化：转小写、去空白与常见标点 */
  private normalize(text: string): string {
    return text.toLowerCase().replace(/[\s，。？！、；：“”‘’《》（）,.?!;:()\-—…]/g, '');
  }

  /**
   * 同义词归一：先把各种说法替换成规范词，再剥停用词。
   *
   * ⚠️ 顺序不能反 —— stripStopWords 是逐字删除，会先把「这座山」剥成「座山」，
   *    别名就永远匹配不上了。必须先替换（此时别名还完整）再剥离。
   *
   * ⚠️ 用 split/join 而非 while(s.indexOf) 循环 —— 后者的终止条件是
   *    「不再含别名」，若别名是规范词的子串就会无限膨胀。规范词取最短后
   *    本表已无此情况，但保留下面的守卫作为防御。
   */
  private canonicalize(text: string): string {
    let s: string = this.normalize(text);
    for (let g = 0; g < SYNONYM_GROUPS.length; g++) {
      const group: string[] = SYNONYM_GROUPS[g];
      const canon: string = group[0];
      for (let i = 1; i < group.length; i++) {
        const alias: string = group[i];
        // 防御：别名是规范词的子串（含相等）→ 跳过，否则会破坏已归一的文本
        if (canon.indexOf(alias) !== -1) continue;
        s = s.split(alias).join(canon);
      }
    }
    return this.stripStopWords(s);
  }

  /** 剥离疑问词/语气词，提升口语提问的召回 */
  private stripStopWords(text: string): string {
    let s = this.normalize(text);
    for (let i = 0; i < STOP_WORDS.length; i++) {
      const w = STOP_WORDS[i];
      while (s.indexOf(w) !== -1) {
        s = s.replace(w, '');
      }
    }
    return s;
  }

  /** 字符级 2-gram 切分 */
  private bigrams(text: string): string[] {
    const s = this.normalize(text);
    const grams: string[] = [];
    if (s.length === 0) return grams;
    if (s.length === 1) {
      grams.push(s);
      return grams;
    }
    for (let i = 0; i + 1 < s.length; i++) {
      grams.push(s.substring(i, i + 2));
    }
    return grams;
  }

  /** Dice 系数：2|A∩B| / (|A|+|B|) */
  private diceSimilarity(a: string, b: string): number {
    const ga: string[] = this.bigrams(a);
    const gb: string[] = this.bigrams(b);
    if (ga.length === 0 || gb.length === 0) return 0;
    let hit: number = 0;
    for (let i = 0; i < ga.length; i++) {
      if (gb.indexOf(ga[i]) !== -1) hit++;
    }
    return (2 * hit) / (ga.length + gb.length);
  }

  /**
   * 单条打分：0 ~ 2.5 之间（**预计算版**）。
   *
   * ⚠️ 与旧 `scoreEntry` 的唯一区别：**query 侧的量（q / qRaw）改由调用方传入**。
   *    旧版在 194 次调用里把 `canonicalize(query)` / `normalize(query)` 各算了 194 遍，
   *    而 query 一个字都没变 —— 这是本次优化省下的最大一块。
   *
   * 判定逻辑与旧版【逐字一致】，只是取值来源从「现算」变成「查表」。
   * `useCanonical=false` 走 tStrip，供 A 组三层对比测试的 T2 层使用。
   */
  private scorePrepared(q: string, qRaw: string, e: PreparedEntry,
                        useCanonical: boolean): number {
    const t: string = useCanonical ? e.tCanon : e.tStrip;
    if (qRaw === '' || e.tRaw === '') return 0;

    let score: number = 0;
    // 完全相等
    if (e.tRaw === qRaw) score += 1.0;
    // 问题包含提问（去掉疑问词后再比，命中更准）
    if (q.length >= 2 && t.indexOf(q) !== -1) score += 0.6;
    // 提问包含问题
    if (t.length >= 2 && q.indexOf(t) !== -1) score += 0.6;
    // 字形近似度
    score += this.diceSimilarity(q, t) * 0.8;
    // 答案正文里出现完整提问（弱权重）
    if (qRaw.length >= 2 && e.aRaw.indexOf(qRaw) !== -1) score += 0.3;

    return score;
  }

  /** 全库打分并返回 topN 候选。
   *  useCanonical=false = A 组测试里的 T2 层（归一前）；默认 true 即生产行为 T3′。 */
  rankCandidates(query: string, topN: number, useCanonical: boolean = true): KnowledgeHit[] {
    // ★ 优化：query 侧的量【只算一次】。
    //   旧版把这两行放在 scoreEntry 里，于是每次检索都重算 194 遍 —— 而 query 一个字都没变。
    const q: string = useCanonical ? this.canonicalize(query) : this.stripStopWords(query);
    const qRaw: string = this.normalize(query);

    const hits: KnowledgeHit[] = [];
    for (let i = 0; i < this.prepared.length; i++) {
      const e: PreparedEntry = this.prepared[i];
      hits.push(new KnowledgeHit(e.id, e.key, e.answer,
        this.scorePrepared(q, qRaw, e, useCanonical)));
    }
    hits.sort((a: KnowledgeHit, b: KnowledgeHit): number => b.score - a.score);
    const n: number = topN > hits.length ? hits.length : topN;
    return hits.slice(0, n);
  }

  /**
   * 导出全部条目，用于整份同步到教师端。
   * 编号规则必须和 rankCandidates 完全一致（数据条目 D+下标、FAQ F+下标）——
   * 否则教师端的「热门知识点」条目 id 会和 App 上报的命中 id 对不上。
   */
  exportAll(): KnowledgeEntry[] {
    const out: KnowledgeEntry[] = [];
    const keys: string[] = Object.keys(this.data);
    for (let i = 0; i < keys.length; i++) {
      const key: string = keys[i];
      out.push({ id: 'D' + i, question: key, answer: this.data[key] });
    }
    for (let i = 0; i < this.faq.length; i++) {
      const item: FaqItem = this.faq[i];
      out.push({ id: 'F' + i, question: item.question, answer: item.answer });
    }
    return out;
  }

  /** 本地增强检索：候选集打分命中则采纳，否则回落到原有 search() */
  searchEnhanced(query: string): string {
    if (query.trim() === '') return '';
    const hits: KnowledgeHit[] = this.rankCandidates(query, 1);
    if (hits.length > 0 && hits[0].score >= MATCH_MIN_SCORE) {
      return hits[0].answer;
    }
    return this.search(query);
  }

  /**
   * 调试用：返回 topN 候选的 id / 分数 / 问题文本。
   * 真机排查：在 sendMessage() 里 console.info(this.knowledge.debugRank(query, 5))
   */
  debugRank(query: string, topN: number = 5): string {
    const hits: KnowledgeHit[] = this.rankCandidates(query, topN);
    const lines: string[] = [];
    for (let i = 0; i < hits.length; i++) {
      const h: KnowledgeHit = hits[i];
      lines.push(h.id + '  ' + h.score.toFixed(3) + '  ' + h.question);
    }
    return lines.join('\n');
  }

  // ==================== 端侧模型接入（骨架，待引擎确认后填充） ====================

  /** 端侧模型是否可用。引擎确认前恒为 false，全部走本地检索 */
  private modelAvailable: boolean = false;

  /**
   * 端侧模型适配层。约定：只返回候选集 id（如 "F37"）或 "NO_MATCH"，
   * 禁止返回自由文本。当前为空实现，待方案二/方案三验证后填入。
   */
  private async invokeLocalModel(query: string, candidates: KnowledgeHit[]): Promise<string> {
    // TODO(待确认引擎后填入): 方案二 ArkData AIP 文本向量化 / 方案三 MindSpore Lite
    return 'NO_MATCH';
  }

  /** 把模型返回的 id 反查成知识库原文，非法 id 返回 '' */
  private resolveAnswer(raw: string, candidates: KnowledgeHit[]): string {
    const id: string = raw.trim().toUpperCase();
    for (let i = 0; i < candidates.length; i++) {
      if (candidates[i].id === id) return candidates[i].answer;
    }
    return '';
  }

  /** 超时保护：到期返回 "NO_MATCH"，后续走降级 */
  private withTimeout(p: Promise<string>, ms: number): Promise<string> {
    const guard: Promise<string> = new Promise((resolve: (v: string) => void) => {
      setTimeout(() => { resolve('NO_MATCH'); }, ms);
    });
    return Promise.race([p, guard]);
  }

  /**
   * 对外统一入口：端侧模型 -> 本地增强检索 -> 原有 search()。
   * 任何一步异常/超时/无匹配均静默降级，本方法不抛异常。
   */
  async searchWithModel(query: string): Promise<string> {
    const q: string = query.trim();
    if (q === '') return '';

    const local: string = this.searchEnhanced(q);

    // 模型不可用：直接返回本地结果，零额外开销
    if (!this.modelAvailable) return local;

    const candidates: KnowledgeHit[] = this.rankCandidates(q, CANDIDATE_TOP_N);
    if (candidates.length === 0) return local;

    try {
      const picked: string = await this.withTimeout(
        this.invokeLocalModel(q, candidates), MODEL_TIMEOUT_MS);
      if (picked !== 'NO_MATCH' && picked.trim() !== '') {
        const text: string = this.resolveAnswer(picked, candidates);
        if (text !== '') return text;
      }
    } catch (e) {
      // 静默降级：模型不可用、初始化失败、推理异常
    }
    return local;
  }

  getRelevantContext(query: string): string {
    const q = query.toLowerCase().trim();
    const matched: string[] = [];
    for (let i = 0; i < this.faq.length; i++) {
      const faqItem = this.faq[i];
      if (faqItem.question.toLowerCase().indexOf(q) !== -1 ||
        q.indexOf(faqItem.question.toLowerCase()) !== -1) {
        matched.push(faqItem.answer);
        if (matched.length >= 3) break;
      }
    }
    return matched.join('\n');
  }
}