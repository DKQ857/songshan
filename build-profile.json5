{
  "app": {
    // 本仓库不包含任何签名材料（证书 / p12 / 密码）。
    // 本地打包前请在 DevEco Studio 的 Project Structure > Signing Configs 里配置你自己的调试/发布证书，
    // 生成的 signingConfigs 与 products[].signingConfig 请勿提交到仓库。
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
